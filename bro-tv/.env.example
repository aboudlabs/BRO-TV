# انسخ هذا الملف إلى .env.local وضع قيم مشروع Supabase الخاص بك
# (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- اختياري ----
# عنوان موقعك بعد النشر (لمعاينة الروابط عند مشاركتها)
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# خادم TURN لتحسين «بث الشاشة» خلف الشبكات الصارمة (يمكن وضع أكثر من رابط مفصولة بفاصلة)
# NEXT_PUBLIC_TURN_URL=turn:YOUR-TURN-HOST:3478,turns:YOUR-TURN-HOST:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
